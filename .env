# ==============================================================================
# TRAVEL MICROSERVICES PLATFORM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- PostgreSQL Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=db_travel
# Đổi port 5432 -> 5433 trên Host để tránh xung đột với PostgreSQL có sẵn trên Windows
POSTGRES_PORT=5433

# --- Redis Configuration ---
REDIS_PORT=6379

# --- Apache Kafka Configuration ---
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_EXTERNAL=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# --- Kafka UI Configuration ---
KAFKA_UI_PORT=8088
